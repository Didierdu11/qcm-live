{"title":"Qualité en agroalimentaire","description":"QCM exemple sur hygiène, traçabilité et HACCP.","questions":[{"id":"q1","text":"Quel est l'objectif principal de la traçabilité alimentaire ?","choices":["Suivre l'historique d'un produit","Réduire automatiquement le prix","Remplacer les contrôles qualité","Éviter tout étiquetage"],"correctIndexes":[0],"partial":{"enabled":false,"requiredCorrectCount":2,"points":0.5}},{"id":"q2","text":"Quelles mesures limitent le risque de contamination croisée ?","choices":["Lavage des mains","Séparation cru/cuit","Utiliser le même ustensile sans nettoyage","Nettoyage et désinfection adaptés"],"correctIndexes":[0,1,3],"partial":{"enabled":true,"requiredCorrectCount":2,"points":0.5}},{"id":"q3","text":"Le système HACCP sert principalement à :","choices":["Identifier et maîtriser les dangers","Créer des campagnes publicitaires","Calculer les salaires","Remplacer la maintenance"],"correctIndexes":[0],"partial":{"enabled":false,"requiredCorrectCount":2,"points":0.5}},{"id":"q4","text":"Quelles informations contribuent à la traçabilité d'un lot ?","choices":["Numéro de lot","Date de production","Nom du fournisseur","Couleur préférée de l'opérateur"],"correctIndexes":[0,1,2],"partial":{"enabled":true,"requiredCorrectCount":2,"points":0.5}},{"id":"q5","text":"Quels éléments doivent être surveillés pour la chaîne du froid ?","choices":["Température de stockage","Enregistrements de température","Respect des consignes de transport","Uniquement l'aspect visuel du carton"],"correctIndexes":[0,1,2],"partial":{"enabled":true,"requiredCorrectCount":2,"points":0.5}}]}